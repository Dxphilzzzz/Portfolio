---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Remotasks',
    meta: "3D Lidar Projects, 2019-2020",
    blurb: 'Worked as a tasker and reviewer on 3D lidar datasets for self-driving car projects.',
    href: 'https://www.remotasks.com/en',
    images: ['/work2.png', '/work3.png', '/work4.png'],
  },
  {
    title: 'TourEase Mati',
    meta: "Tourism Student Project, 2026",
    blurb: 'Helping travelers plan trips around Mati with destinations, activities, and practical city information.',
    href: 'https://tourism.xyz-abc.workers.dev/',
    images: ['/web1.png', '/web2.png', '/web3.png'],
  },
];

---

<Layout title="Dale Philip Banzon - IT Student" description="Dale Philip Banzon is an IT student building fast, useful web products.">
  <section class="home-hero">
    <a class="swipe-cue" href="#work" aria-label="See selected work">
      <span>Swipe to</span>
      <i aria-hidden="true"></i>
      <strong>See work</strong>
    </a>

    <div class="mobile-identity">
      <span class="avatar-mark">DP</span>
      <strong>Dale Philip Banzon</strong>
      <small>IT Student</small>
    </div>

    <div class="hero-media hero-media-a" aria-hidden="true">
      <img src="/prof1.jpg" alt="Profile accent 1" class="hero-frame__image hero-frame__image-1" />
    </div>
    <div class="hero-media hero-media-b" aria-hidden="true">
      <img src="/prof2.jpg" alt="Profile accent 2" class="hero-frame__image hero-frame__image-2" />
    </div>

    <div class="hero-title">  
      <p>Dale Philip Banzon - IT Student</p>
      <h1>Building adaptive web experiences with a learner mindset.</h1>
      <h2>IT student focused on flexible full-stack web development.</h2>
    </div>
  </section>

  <div class="tech-stack">
    <p class="section-label">Tech stack</p>
    <div class="tech-category">
      <p class="tech-category__title">Languages</p>
      <div class="tech-list">
        <span>Java</span>
        <span>PHP</span>
        <span>HTML</span>
        <span>CSS</span>
        <span>JavaScript</span>
        <span>TypeScript</span>
        <span>SQL</span>
        <span>Dart</span>
        <span>Python</span>
      </div>
    </div>
    <div class="tech-category">
      <p class="tech-category__title">Frameworks / Platforms</p>
      <div class="tech-list">
        <span>Astro</span>
        <span>JavaFX</span>
        <span>Node.js</span>
        <span>Laravel</span>
        <span>WordPress</span>
        <span>XAMPP</span>
        <span>Flutter</span>
      </div>
    </div>
    <div class="tech-category">
      <p class="tech-category__title">DBMS & Services</p>
      <div class="tech-list">
        <span>Firebase</span>
        <span>Supabase</span>
      </div>
    </div>
  </div>

  <section class="selected-work" id="work">
    {projects.map((project, pIndex) => (
        <article class="work-item">
        <div class="project-gallery">
            <p class="section-label">Selected work</p>
          <div class="cover-grid">
            {project.images.map((src, i) => (
              <div class="cover-thumb" data-project-index={pIndex} data-img-index={i}>
                <img src={src} alt={`${project.title} ${i + 1}`} />
              </div>
            ))}
          </div>
        </div>

          <div class="work-description">
            <p class="section-label">{project.title}</p>
            <h3>{project.title}</h3>
            <p class="work-meta">{project.meta}</p>
            <p class="work-blurb">{project.blurb}</p>
            {project.href && (
              <p><a class="work-link" href={project.href} target={project.href === '#' ? undefined : '_blank'} rel={project.href === '#' ? undefined : 'noopener'}>View project</a></p>
            )}
          </div>
        </article>
      ))}
  </section>

  <!-- Image modal (opens when a cover image is clicked) -->
  <div id="imageModal" class="image-modal" aria-hidden="true">
    <button class="image-modal__close" aria-label="Close image">×</button>
    <button class="image-modal__nav prev" aria-label="Previous image">‹</button>
    <img class="image-modal__img" src="" alt="" />
    <button class="image-modal__nav next" aria-label="Next image">›</button>
    <div class="image-modal__caption" role="note"></div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('imageModal');
      if (!(modal instanceof HTMLElement)) return;
      const modalEl = modal;

      const modalImg = modalEl.querySelector<HTMLImageElement>('.image-modal__img');
      const modalCaption = modalEl.querySelector<HTMLDivElement>('.image-modal__caption');
      const closeBtn = modalEl.querySelector<HTMLButtonElement>('.image-modal__close');
      const prevBtn = modalEl.querySelector<HTMLButtonElement>('.image-modal__nav.prev');
      const nextBtn = modalEl.querySelector<HTMLButtonElement>('.image-modal__nav.next');
      if (!modalImg || !modalCaption || !closeBtn || !prevBtn || !nextBtn) return;

      const modalImgEl = modalImg;
      const modalCaptionEl = modalCaption;
      const closeBtnEl = closeBtn;
      const prevBtnEl = prevBtn;
      const nextBtnEl = nextBtn;

      const projectImages: string[][] = Array.from(document.querySelectorAll('.work-item')).map((item) => {
        return Array.from(item.querySelectorAll('.cover-grid img')).map((img) => {
          if (img instanceof HTMLImageElement) return img.src;
          return '';
        }).filter(Boolean) as string[];
      });

      let current = { p: 0, i: 0 };

      function openModal(pIndex: number, imgIndex: number) {
        const imgs = projectImages[pIndex];
        if (!imgs || imgIndex < 0 || imgIndex >= imgs.length) return;

        current.p = pIndex;
        current.i = imgIndex;
        modalImgEl.src = imgs[imgIndex];

        const labelElement = document.querySelectorAll('.work-item')[pIndex]?.querySelector('.section-label');
        const labelText = labelElement?.textContent?.trim() || '';
        modalCaptionEl.textContent = `${labelText} — ${imgIndex + 1}`;

        modalEl.classList.add('open');
        modalEl.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modalEl.classList.remove('open');
        modalEl.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        modalImgEl.src = '';
      }

      function showNext() {
        const imgs = projectImages[current.p];
        if (!imgs || imgs.length === 0) return;
        current.i = (current.i + 1) % imgs.length;
        modalImgEl.src = imgs[current.i];
      }

      function showPrev() {
        const imgs = projectImages[current.p];
        if (!imgs || imgs.length === 0) return;
        current.i = (current.i - 1 + imgs.length) % imgs.length;
        modalImgEl.src = imgs[current.i];
      }

      document.querySelectorAll('.cover-thumb').forEach((thumbElement) => {
        if (!(thumbElement instanceof HTMLElement)) return;
        thumbElement.style.cursor = 'zoom-in';
        thumbElement.addEventListener('click', () => {
          const p = Number(thumbElement.dataset.projectIndex);
          const i = Number(thumbElement.dataset.imgIndex);
          openModal(p, i);
        });
      });

      prevBtn.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });
      nextBtn.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });

      modalEl.addEventListener('click', (e) => {
        if (e.target === modalEl || e.target === closeBtnEl) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (!modalEl.classList.contains('open')) return;
        if (e.key === 'Escape') closeModal();
        if (e.key === 'ArrowRight') showNext();
        if (e.key === 'ArrowLeft') showPrev();
      });
    });
  </script>

</Layout>
